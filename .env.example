# =====================================
# Aplicação
# =====================================

APP_NAME=TalentMatch AI Agent
APP_VERSION=1.0.0

# development | production
ENVIRONMENT=development

PORT=8000


# =====================================
# Google Gemini
# =====================================

GEMINI_API_KEY=your_gemini_api_key_here


# =====================================
# ChromaDB
# =====================================

# Caminho persistente dentro do container
CHROMA_PATH=/app/data/chroma

# Nome da coleção vetorial
CHROMA_COLLECTION=talentmatch_candidates


# =====================================
# CORS
# =====================================

# Separar múltiplas origens por vírgula
# Exemplo:
# localhost para desenvolvimento
# Replit para produção

ALLOWED_ORIGINS=http://localhost:5173,https://talentmatch.replit.app


# =====================================
# Integração Backend Java (opcional)
# =====================================

JAVA_BACKEND_URL=http://localhost:8080

JAVA_BACKEND_CALLBACK_ENABLED=false